{
  "name": "@plant-memory/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared JSON schemas, TypeScript types, and the generated API client. Owned by the technical lead (PM-01).",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*",
    "./api": "./src/api.generated.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/api.generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
