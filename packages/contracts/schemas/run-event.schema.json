{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plant-memory.local/schemas/run-event.schema.json",
  "title": "RunEvent",
  "description": "Persisted progress event streamed to the UI over SSE. Shows completed actions and findings, never hidden model reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "sequence", "type", "at", "payload"],
  "properties": {
    "id": { "type": "string" },
    "run_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "string",
      "enum": [
        "run.created",
        "run.started",
        "snapshot.frozen",
        "scope.parsed",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "finding.added",
        "section.completed",
        "section.incomplete",
        "clarification.requested",
        "clarification.answered",
        "limit.reached",
        "package.saved",
        "run.completed",
        "run.failed",
        "run.cancelled"
      ]
    },
    "at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
