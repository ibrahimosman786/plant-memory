# ---------------------------------------------------------------------------
# Plant Memory — local development environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application database (engineering records) -----------------------------
DATABASE_URL=postgresql+psycopg://pm_app:pm_app@localhost:5432/plant_memory
# Migration role (owns tables; bypasses RLS). The app role above must NOT.
DATABASE_ADMIN_URL=postgresql+psycopg://pm_admin:pm_admin@localhost:5432/plant_memory

# --- eve workflow database (separate role, separate database) ----------------
WORKFLOW_POSTGRES_URL=postgres://pm_workflow:pm_workflow@localhost:5432/plant_memory_workflow

# --- Cache / concurrency coordination ---------------------------------------
VALKEY_URL=redis://localhost:6379/0

# --- Object storage: "local" writes under .data/storage; "s3" uses boto3 ----
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.data/storage
S3_BUCKET_ORIGINALS=plant-memory-originals
S3_BUCKET_DERIVED=plant-memory-derived
S3_BUCKET_REPORTS=plant-memory-reports
S3_BUCKET_ASSETS=plant-memory-assets
AWS_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000   # MinIO / LocalStack when STORAGE_BACKEND=s3

# --- Queue: "postgres" (dev, SKIP LOCKED) or "sqs" ---------------------------
QUEUE_BACKEND=postgres
SQS_QUEUE_URL=
SQS_DLQ_URL=

# --- Identity: "dev" issues HS256 tokens from POST /v1/auth/dev-login --------
AUTH_BACKEND=dev
AUTH_DEV_SECRET=change-me-dev-secret-at-least-32-chars-long
# COGNITO_USER_POOL_ID=
# COGNITO_REGION=us-east-1
# COGNITO_CLIENT_ID=

# --- Service-to-service auth (API <-> eve) -----------------------------------
AGENT_JWT_SECRET=change-me-agent-secret-at-least-32-chars-long
AGENT_JWT_ISSUER=https://plant-memory.local/api
AGENT_JWT_AUDIENCE=plant-memory-agent
AGENT_BASE_URL=http://localhost:2000
API_INTERNAL_BASE_URL=http://localhost:8000
# gateway = in-process agent (uses the model when AI_GATEWAY_API_KEY is set, otherwise the spoken checklist)
AGENT_BACKEND=gateway

# --- Keys for the local demo -------------------------------------------------
# Required for a model-chosen agent (Claude via Vercel AI Gateway):
#   1. Create a key at https://vercel.com/docs/ai-gateway
#   2. Set AI_GATEWAY_API_KEY below
#   3. Restart the API
# Without it, investigations still run as a spoken engineering checklist
# (same tools, fixed order). The UI pill reads "Checklist agent" vs "Model agent".
#
# Clerk (already wired in apps/web/.env.local — do not commit secrets):
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   CLERK_SECRET_KEY
# Local HS256 secrets below are not third-party keys.
# Not needed for the interview: AWS, Cognito, SQS, S3.

# --- Model gateway (Vercel AI Gateway) ---------------------------------------
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_REASONING=anthropic/claude-sonnet-5.5
MODEL_ESCALATION=anthropic/claude-opus-5.5
# Extra explicitly selectable provider/model IDs; validated against the live catalog by scripts/check_models.py.
MODEL_ALTERNATIVES=["openai/gpt-6-astra"]
# Server-to-server Clerk session exchange; set the same random value in apps/web/.env.local.
SESSION_EXCHANGE_SECRET=
# Add the exact frontend HTTPS origin when deploying the API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set to "hash" to avoid downloading the embedding model (tests / CI).
EMBEDDING_BACKEND=fastembed

# --- Run limits (section 8 of the plan) --------------------------------------
RUN_MAX_CONCURRENT_LLM_CALLS=3
ENV_MAX_ACTIVE_LLM_CALLS=8
RUN_MAX_TOOL_INVOCATIONS=20
RUN_MAX_CLARIFICATION_CYCLES=2
RUN_ACTIVE_DEADLINE_SECONDS=600
RUN_MAX_COST_USD=1.50
RUN_MAX_OUTPUT_TOKENS=40000
ENV_MAX_CONCURRENT_RUNS=3

# --- Budget guard (section 14) -----------------------------------------------
# AI jobs stop launching when the monthly model spend reaches this (USD).
MONTHLY_MODEL_BUDGET_USD=200

# --- Upload limits -----------------------------------------------------------
MAX_FILES_PER_PROJECT=50
MAX_PDF_PAGES_PER_PROJECT=300
MAX_FILE_BYTES=26214400

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=plant-memory-api
LOG_LEVEL=INFO
